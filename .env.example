# Copy to `.env` for local work. The only variable the app itself reads is VITE_API_URL; the rest
# configure the dev server and the browser audits.
#
# Vite inlines VITE_* at BUILD time, so a production deploy sets VITE_API_URL before `npm run build`
# — it is not read from the environment at runtime. See docs/cloud-deploy.md.

# Vite dev server: set to "true" to disable hot reload and file watching, which is
# useful when an agent is editing files and the flicker is unwanted (see vite.config.ts).
DISABLE_HMR="false"

# API base URL for the backend (default: http://localhost:4000).
# Read by Vite at BUILD time, so a production deploy sets this to the hosted API before `npm run build`
# (see docs/cloud-deploy.md). No trailing slash.
VITE_API_URL="http://localhost:4000"

# --- the browser audits (tools/audit-*.mjs) -------------------------------------------------

# The app under audit. The dev server serves port 3000 by default.
APP_URL="http://127.0.0.1:3000/"

# Only needed when Chrome is somewhere unusual; the tools search the standard
# install paths first.
# CHROME="C:/Program Files/Google/Chrome/Application/chrome.exe"

# DevTools port the audit drives, when the default clashes with another run.
# CDP_PORT="9335"
