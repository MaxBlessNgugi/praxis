// Praxis Church OS — data model.
//
// Three conventions hold across every model here, because each one is expensive to retrofit:
//
//   1. Money is Decimal, never Float. A giving ledger that drifts by a shilling is not a ledger of
//      record. Conversion to a plain number happens at the JSON edge, nowhere else.
//   2. Deletion is soft. `deletedAt` marks a retired row; `SoftDeletedRecord` keeps the reason, the
//      actor and a snapshot, which is what the console's Trash screen reads and what makes a
//      restore possible months later.
//   3. Closed sets are enums, not free strings. A member's status or a payment method is one of a
//      known list, and the database should be the thing that says so.
//
// AuditLog is deliberately append-only: it has no `updatedAt` and no `deletedAt`. An audit trail
// that can be edited is not an audit trail.
//
// Multi-tenancy is the fourth: every model that belongs to a church carries a **required**
// `organizationId`, and the database enforces it (NOT NULL plus a foreign key). Services never pass
// it — one client does, from the request's own context, in `src/lib/prisma.ts`. That is what the
// `@default(dbgenerated())` on those columns means here: the value is supplied *outside* Prisma, by
// the tenant-scoped client, rather than by a column default or by hand at 200 call sites. A write
// that somehow arrives without it is refused by Postgres rather than filed under the wrong parish.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon (and any PgBouncer front end) serves the application and migrations on different
  // connections: the app uses the pooled URL, `prisma migrate` needs the direct one because a
  // transaction pooler cannot run the DDL a migration emits. Locally both point at the same line.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------------------------

enum AuditAction {
  create
  update
  delete
  restore
  login
  /// Someone looked without changing anything: a Praxis operator in a support session, most of all.
  /// It is separate from `update` on purpose — a church reading its own trail must be able to tell
  /// "somebody opened our records" from "somebody changed them".
  view
}

/// A panel key plus the three actions, as JSON — the same shape the frontend's permission module
/// uses, so the server and the UI resolve rights the same way instead of disagreeing.
model Role {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  description String?
  panels      Json
  actions     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users       User[]
  memberships OrganizationMember[] @relation("MembershipRole")

  @@index([deletedAt])
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  roleId       String?

  /// Set when this login belongs to someone on the register. It is what lets a volunteer act as
  /// themselves — asking for cover on their own duty — instead of only an administrator acting for
  /// them, which is a claim the server could not otherwise verify.
  memberId    String?   @unique
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  /// Created by an administrator's invitation and still waiting on its activation link — the
  /// account has never signed in, and the only way forward is a re-issued link, not a reset.
  isInvited   Boolean   @default(false)

  /// A Praxis employee rather than a church's own account: it is what opens `/api/vendor`, the only
  /// routes that deliberately cross between churches (list them, assign a plan, record a payment).
  /// Default false, so an account created by a church can never reach another's records.
  isPlatformAdmin Boolean @default(false)

  // Account lockout, counted per account rather than per IP: the reference parish system locks for
  // 15 minutes after a configured number of failures, and a shared office machine makes per-account
  // the only meaningful counter.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  /// Which generation of sessions this account will accept.
  ///
  /// A token carries the value it was minted with, and a request whose token disagrees is refused.
  /// Changing or resetting a password bumps this, which is what makes those two acts end every other
  /// session on the account — the copy of a token left on a shared parish machine stops working the
  /// moment the password it was protecting is replaced.
  tokenVersion Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  role               Role?                 @relation(fields: [roleId], references: [id])
  member             Member?               @relation("UserAccount", fields: [memberId], references: [id], onDelete: SetNull)
  tithes             Tithe[]
  offerings          Offering[]
  announcements      Announcement[]        @relation("AnnouncementAuthor")
  broadcasts         Broadcast[]           @relation("BroadcastAuthor")
  auditLogs          AuditLog[]
  softDeletes        SoftDeletedRecord[]   @relation("SoftDeleteActor")
  softRestores       SoftDeletedRecord[]   @relation("SoftRestoreActor")
  welfareApprovals   WelfareDisbursement[] @relation("WelfareApprover")
  paymentsRecorded   SubscriptionPayment[] @relation("PaymentRecorder")
  serviceReports     ServiceReport[]       @relation("ServiceReportAuthor")
  sealedMinutes      Meeting[]             @relation("MeetingMinutes")
  swapDecisions      SwapRequest[]         @relation("SwapDecider")
  charityLed         CharityActivity[]     @relation("CharityLead")
  financeAudit       FinanceAuditEntry[]   @relation("FinanceAuditActor")
  settingsChanged    AppSetting[]          @relation("SettingEditor")
  uploadedFiles      StoredFile[]          @relation("FileUploader")
  certificatesIssued Certificate[]         @relation("CertificateIssuer")
  /// The churches this account may serve. One login, several parishes, one role in each.
  memberships        OrganizationMember[]  @relation("OrganizationMembership")
  resetTokens        PasswordResetToken[]
  stockMovements     StockMovement[]       @relation("StockActor")
  stockTakesCounted  StockTake[]           @relation("StockTaker")
  stockTakesApproved StockTake[]           @relation("StockTakeApprover")
  purchasesRecorded  Purchase[]            @relation("PurchaseRecorder")
  issuesIssued       Issue[]               @relation("IssueIssuer")
  issuesAuthorized   Issue[]               @relation("IssueAuthorizer")
  transfersMoved     Transfer[]            @relation("TransferMover")

  @@index([roleId])
  @@index([deletedAt])
}

/// A password reset in flight.
///
/// The token itself is never stored, only its SHA-256, so a copy of this table is not a set of keys to
/// every account. One row is one request: it expires, it is spent when used, and asking again is a new
/// row — so an old email cannot be replayed and asking twice does not extend the first one's life.
///
/// It belongs to the account rather than to a church, because a password is the account's and the
/// person asking has not signed in yet — there is no church context to write it in.
model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token that was emailed. Never the token.
  tokenHash String @unique

  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------------------------
// The tenant
// ---------------------------------------------------------------------------------------------

/// A church on the platform.
///
/// This is the tenancy boundary. Every row that belongs to a church names one of these, every
/// authenticated request resolves exactly one before it reads anything, and a query that has not
/// resolved one is refused rather than run — see `src/lib/tenant.ts` and `src/lib/prisma.ts`. The
/// alternative (remembering to add a filter at 190 call sites) is a cross-tenant leak that only
/// shows up in production.
///
/// Roles and accounts stay global: a person is one login that can serve several churches, and a role
/// is a rights template the platform ships rather than something each parish invents. Membership —
/// which church, and in what capacity — is `OrganizationMember`.
model Organization {
  id          String    @id @default(uuid())
  name        String
  /// The stable, human-readable handle: `destiny-sanctuary`. Used in URLs and support, never a key.
  slug        String    @unique
  isActive    Boolean   @default(true)
  /// When the church finished its welcome wizard. Null on a church that signed itself up and has not
  /// yet said where it meets — which is what the console uses to decide whether to show the wizard.
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]

  profile              OrganizationProfile?  @relation("OrganizationProfile")
  memberships          OrganizationMember[]  @relation("OrganizationMembership")
  households           Household[]
  members              Member[]
  ministries           Ministry[]
  ministryMembers      MinistryMember[]
  services             Service[]
  attendance           Attendance[]
  tithes               Tithe[]
  offerings            Offering[]
  certificates         Certificate[]
  projects             Project[]
  projectContributions ProjectContribution[]
  welfareDisbursements WelfareDisbursement[]
  charityActivities    CharityActivity[]
  settings             AppSetting[]
  financeAudit         FinanceAuditEntry[]
  meetings             Meeting[]
  resolutions          Resolution[]
  documents            GovernanceDocument[]
  announcements        Announcement[]
  broadcasts           Broadcast[]
  events               Event[]
  prayerRequests       PrayerRequest[]
  auditLogs            AuditLog[]
  softDeletes          SoftDeletedRecord[]
  liturgyItems         OrderOfServiceItem[]
  rosterDuties         RosterDuty[]
  swapRequests         SwapRequest[]
  serviceReports       ServiceReport[]
  files                StoredFile[]
  suppliers            Supplier[]
  inventoryItems       InventoryItem[]
  stockMovements       StockMovement[]
  stockTakes           StockTake[]
  purchases            Purchase[]
  issues               Issue[]
  transfers            Transfer[]

  @@index([deletedAt])
}

/// Which churches an account serves, and in what capacity in each.
///
/// `roleKey` here is the authority: rights are read from *this* membership's role on every request,
/// so the same person can be an administrator in one parish and a viewer in another. The account's
/// own role stays as the default a membership is created with.
model OrganizationMember {
  id             String    @id @default(uuid())
  organizationId String    @default(dbgenerated())
  userId         String
  roleId         String?
  /// The church the account lands in when it signs in without choosing.
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation("OrganizationMembership", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("OrganizationMembership", fields: [userId], references: [id], onDelete: Cascade)
  role         Role?        @relation("MembershipRole", fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------------------------
// The church's own profile
// ---------------------------------------------------------------------------------------------

/// One row per church. The console's Settings > Organization Profile screen reads and writes exactly
/// this, and it is the tenant's own letterhead rather than the platform's record of the tenant.
model OrganizationProfile {
  id             String       @id @default(uuid())
  organizationId String       @unique @default(dbgenerated())
  organization   Organization @relation("OrganizationProfile", fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  tagline        String?
  location       String
  address        String?
  phone          String?
  email          String?
  website        String?
  vision         String?
  mission        String?
  coreValues     String[]
  serviceTimes   Json?
  socials        Json?
  /// The church's own mark, shown on the console and printed on certificates. Held as a file id so
  /// the artwork lives in one place rather than being pasted into the profile as a data URL.
  logoFileId     String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  logo StoredFile? @relation("OrgLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------------------------

enum MemberStatus {
  active
  transferred
  deceased
  inactive
}

enum BaptismType {
  baptized
  dedicated
  none
}

model Household {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  unitNumber     String
  location       String
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  members Member[]

  @@unique([organizationId, unitNumber])
  @@index([organizationId])
  @@index([deletedAt])
}

model Member {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  memberId    String
  firstName   String
  lastName    String
  initials    String?
  email       String?
  phone       String?
  nationalId  String?
  dateOfBirth DateTime?
  location    String

  householdId     String?
  householdRole   String?
  isHouseholdHead Boolean @default(false)

  status           MemberStatus @default(active)
  baptismType      BaptismType  @default(baptized)
  baptismDate      DateTime?
  baptismOfficiant String?
  envelopeNumber   String?
  pastoralNotes    String?
  tags             String[]
  joinedAt         DateTime     @default(now())

  /// The console's Birthdays & Anniversaries screen counts "X years of marriage", so a wedding date
  /// has to be storable. Nullable because most of a register will not have one.
  weddingAnniversary DateTime?

  /// Optional, and optional on purpose: a photograph of a church member is personal data, and a
  /// register that refuses to save a person until it has a picture of them is a register nobody fills
  /// in. A file id rather than a URL, so the picture is served by the API behind the same auth.
  photoFileId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  household          Household?            @relation(fields: [householdId], references: [id])
  photo              StoredFile?           @relation("MemberPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  userAccount        User?                 @relation("UserAccount")
  ministries         MinistryMember[]
  ledMinistries      Ministry[]            @relation("MinistryLeader")
  officiatedServices Service[]             @relation("ServiceOfficiant")
  attendance         Attendance[]
  welfareAssigned    WelfareDisbursement[] @relation("WelfareAssignee")
  chairedMeetings    Meeting[]             @relation("MeetingChair")
  minuteKeeping      Meeting[]             @relation("MeetingSecretary")
  tithes             Tithe[]
  contributions      ProjectContribution[]
  welfareCases       WelfareDisbursement[]
  prayerRequests     PrayerRequest[]
  rosterDuties       RosterDuty[]          @relation("DutyHolder")
  swapRequests       SwapRequest[]         @relation("SwapRequester")
  reliefSwaps        SwapRequest[]         @relation("SwapReplacement")
  organizedEvents    Event[]               @relation("EventOrganizer")
  certificates       Certificate[]         @relation("CertificateMember")
  custodianFor       InventoryItem[]       @relation("InventoryCustodian")

  /// Every register number, envelope number and unit number in this system is unique *within a
  /// church*, not across the platform: two parishes both start their register at #MBR-1001, and a
  /// global unique here would refuse a second church its own ENV-1001.
  @@unique([organizationId, memberId])
  @@unique([organizationId, envelopeNumber])
  @@index([organizationId])
  @@index([householdId])
  @@index([status])
  @@index([lastName, firstName])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------------------------
// Groups and ministry
// ---------------------------------------------------------------------------------------------

model Ministry {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  leaderId       String?
  meetingDay     String?
  location       String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  leader       Member?              @relation("MinistryLeader", fields: [leaderId], references: [id])
  members      MinistryMember[]
  rosterDuties RosterDuty[]
  liturgyItems OrderOfServiceItem[]
  issues       Issue[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([leaderId])
  @@index([deletedAt])
}

model MinistryMember {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ministryId     String
  memberId       String
  roleTitle      String       @default("Member")
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  ministry Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([ministryId, memberId])
  @@index([organizationId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------------------------
// Services and attendance
// ---------------------------------------------------------------------------------------------

/// The kinds of gathering a parish actually puts on a calendar.
///
/// Deliberately a short list rather than free text: a planner that lets every clerk invent a
/// category cannot report by it, and "Sunday service" is spelled the same way in every parish.
/// `special` covers the one-offs — a baptism Sunday, a crusade, an induction.
enum ServiceKind {
  worship
  midweek
  prayer
  special
  other
}

model Service {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  kind           ServiceKind  @default(worship)
  heldAt         DateTime
  startTime      String?
  venue          String
  theme          String?
  officiantId    String?
  notes          String?
  isTemplate     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  officiant  Member?              @relation("ServiceOfficiant", fields: [officiantId], references: [id])
  attendance Attendance[]
  offerings  Offering[]
  liturgy    OrderOfServiceItem[]
  roster     RosterDuty[]
  report     ServiceReport?

  @@index([organizationId])
  @@index([heldAt])
  @@index([officiantId])
  @@index([deletedAt])
}

enum AttendanceKind {
  service
  group
  meeting
}

/// One row is one counted attendance, so a census ("712 adults, 140 children, 23 visitors") is a
/// handful of rows rather than a schema change.
model Attendance {
  id             String         @id @default(uuid())
  organizationId String         @default(dbgenerated())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceId      String?
  memberId       String?
  kind           AttendanceKind @default(service)
  count          Int            @default(1)
  visitorName    String?
  notes          String?
  recordedAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  service Service? @relation(fields: [serviceId], references: [id])
  member  Member?  @relation(fields: [memberId], references: [id])

  @@index([organizationId])
  @@index([serviceId])
  @@index([memberId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------------------------
// Giving and money
// ---------------------------------------------------------------------------------------------

enum PaymentMethod {
  cash
  mpesa
  cheque
  bank_transfer
  card
}

model Tithe {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  txCode       String
  memberId     String?
  donorName    String
  envelopeNo   String?
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  category     String        @default("General Tithe")
  reference    String?
  status       String        @default("completed")
  receivedAt   DateTime      @default(now())
  recordedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  member     Member? @relation(fields: [memberId], references: [id])
  recordedBy User?   @relation(fields: [recordedById], references: [id])

  @@unique([organizationId, txCode])
  @@index([organizationId])
  @@index([memberId])
  @@index([receivedAt])
  @@index([deletedAt])
}

model Offering {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  txCode       String
  serviceId    String?
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  category     String        @default("Sunday Offering")
  reference    String?
  notes        String?
  receivedAt   DateTime      @default(now())
  recordedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  service    Service? @relation(fields: [serviceId], references: [id])
  recordedBy User?    @relation(fields: [recordedById], references: [id])

  @@unique([organizationId, txCode])
  @@index([organizationId])
  @@index([serviceId])
  @@index([receivedAt])
  @@index([deletedAt])
}

enum ProjectStatus {
  planned
  active
  completed
  paused
}

model Project {
  id             String        @id @default(uuid())
  organizationId String        @default(dbgenerated())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  targetAmount   Decimal       @db.Decimal(12, 2)
  status         ProjectStatus @default(planned)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  contributions ProjectContribution[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
}

/// A pledge is money promised and a cash row is money banked, and the funding screen reports them
/// separately — "in escrow" against "signed, not yet received". One column, so they cannot be
/// conflated into a total that overstates what the church holds.
enum ContributionKind {
  cash
  pledge
}

model ProjectContribution {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  txCode        String
  projectId     String
  memberId      String?
  donorName     String
  amount        Decimal          @db.Decimal(12, 2)
  method        PaymentMethod
  kind          ContributionKind @default(cash)
  reference     String?
  contributedAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id])

  @@unique([organizationId, txCode])
  @@index([organizationId])
  @@index([projectId])
  @@index([deletedAt])
}

enum WelfareStatus {
  requested
  approved
  disbursed
  declined
}

/// The relief a case falls under, as the welfare screen groups it — a deacon reporting back on the
/// year needs "how much went to medical" to be answerable.
enum WelfareCategory {
  medical
  education
  food
  funeral
  rent
  utility
  other
}

model WelfareDisbursement {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  caseCode        String
  memberId        String?
  beneficiaryName String
  amount          Decimal         @db.Decimal(12, 2)
  purpose         String
  category        WelfareCategory @default(other)
  status          WelfareStatus   @default(requested)
  requestedAt     DateTime        @default(now())
  assignedToId    String?
  approvedById    String?
  disbursedAt     DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  member     Member? @relation(fields: [memberId], references: [id])
  assignedTo Member? @relation("WelfareAssignee", fields: [assignedToId], references: [id])
  approvedBy User?   @relation("WelfareApprover", fields: [approvedById], references: [id])

  @@unique([organizationId, caseCode])
  @@index([organizationId])
  @@index([memberId])
  @@index([status])
  @@index([deletedAt])
}

enum CharityStatus {
  recorded
  verified
  flagged
}

/// Money or goods the church gives away.
///
/// Modelled as an expenditure rather than a vague "activity" because every row costs something
/// somebody must account for: the console's screen shows the item bought, the initiative it belongs
/// to, the vendor paid, and whether it has been audited.
model CharityActivity {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  code       String
  item       String
  initiative String
  vendor     String?
  amount     Decimal       @db.Decimal(12, 2)
  occurredAt DateTime      @default(now())
  status     CharityStatus @default(recorded)
  notes      String?
  ledById    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  ledBy User? @relation("CharityLead", fields: [ledById], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([occurredAt])
  @@index([initiative])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------------------------
// Settings the church changes about itself
// ---------------------------------------------------------------------------------------------

/// One key per settings screen: `notifications`, `integrations`, `customization`.
///
/// A key/value row rather than a column per toggle, because these are the screens that change most
/// often and each change of shape would otherwise be a migration. The organization profile keeps its
/// own table: it is read on every page and is not a bag of preferences.
model AppSetting {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  key         String
  value       Json
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SettingEditor", fields: [updatedById], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------------------------
// The finance ledger's own audit trail
// ---------------------------------------------------------------------------------------------

enum FinanceAuditAction {
  recorded
  voided
  restored
  approved
  declined
  disbursed
  updated
}

/// Why this exists beside `AuditLog`, and what makes it "immutable".
///
/// `AuditLog` records what the console did; this records what happened to the money, and it is
/// *chained*: each entry carries a SHA-256 hash over its own canonical fields plus the previous
/// entry's hash, so altering or removing any row after the fact breaks every hash that follows it
/// and `GET /api/finance/audit/verify` reports exactly where. `sequence` is handed out under a
/// transaction-scoped advisory lock, which is what stops two simultaneous payments claiming the same
/// position and forking the ledger.
///
/// There is no `updatedAt` and no `deletedAt`, deliberately: an entry that can be edited is not an
/// audit trail.
model FinanceAuditEntry {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  sequence     Int
  action       FinanceAuditAction
  entityName   String
  entityId     String
  summary      String
  amount       Decimal?           @db.Decimal(12, 2)
  actorId      String?
  before       Json?
  after        Json?
  previousHash String
  hash         String
  createdAt    DateTime           @default(now())

  actor User? @relation("FinanceAuditActor", fields: [actorId], references: [id])

  /// The ledger is hash-chained per church: each organisation has its own sequence and its own
  /// chain head, so one parish's entries can never attest for another's.
  @@unique([organizationId, sequence])
  @@index([organizationId])
  @@index([entityName, entityId])
  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------------------------
// Governance
// ---------------------------------------------------------------------------------------------

enum MeetingKind {
  stated
  executive
  emergency
}

enum MeetingStatus {
  scheduled
  held
  cancelled
}

/// One sitting of a council or the congregational meeting.
///
/// `minutes` is stored on the meeting rather than as a separate document because the two are written
/// together and a minute that can drift from its meeting is worse than no minute at all.
model Meeting {
  id             String        @id @default(uuid())
  organizationId String        @default(dbgenerated())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  kind           MeetingKind   @default(stated)
  status         MeetingStatus @default(scheduled)
  heldAt         DateTime
  venue          String
  chairId        String?
  secretaryId    String?
  attendees      Int?
  /// Derived from `attendees` against `quorumRequired`; never accepted from a client.
  quorumMet      Boolean?
  /// What a sitting needed to be quorate, counted from the council roll and snapshotted here.
  quorumRequired Int?
  agenda         Json?
  minutes        String?

  /// Sealing a minute is what closes a sitting: after it the register and the minute are fixed, and
  /// only an administrator may change them. The account is kept beside the date, like a signature.
  minutesFinalizedAt   DateTime?
  minutesFinalizedById String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  chair              Member?      @relation("MeetingChair", fields: [chairId], references: [id], onDelete: SetNull)
  secretary          Member?      @relation("MeetingSecretary", fields: [secretaryId], references: [id], onDelete: SetNull)
  minutesFinalizedBy User?        @relation("MeetingMinutes", fields: [minutesFinalizedById], references: [id], onDelete: SetNull)
  resolutions        Resolution[]

  @@index([organizationId])
  @@index([heldAt])
  @@index([kind])
  @@index([deletedAt])
}

enum ResolutionStage {
  proposed
  voted_approved
  implementing
  closed
}

/// A decision put to a council. The vote is stored as a summary line plus its three counts, because
/// the minute records "carried 7-0" and a parish reads it that way.
model Resolution {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  code           String
  title          String
  summary        String
  sponsor        String
  sponsorOfficer String?
  meetingId      String?
  councilDate    DateTime
  stage          ResolutionStage @default(proposed)
  voteSummary    String?
  votesFor       Int?
  votesAgainst   Int?
  votesAbstain   Int?
  lead           String?
  leadNote       String?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([stage])
  @@index([councilDate])
  @@index([deletedAt])
}

enum DocumentKind {
  bylaw
  policy
  constitution
  minutes
  certificate
  other
}

/// The two ordinances the register records and the church issues certificates for.
enum CertificateKind {
  baptism
  dedication
}

/// The repository the governance screen calls "the foundational bylaws". `isActive` marks the
/// version currently in force, so a superseded policy stays readable without being mistaken for law.
model GovernanceDocument {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  kind           DocumentKind @default(bylaw)
  reference      String
  version        String       @default("1.0")
  adoptedAt      DateTime?
  body           String?
  /// A link out to a file held somewhere else, for a by-law that lives on the church's website.
  fileUrl        String?
  /// The copy the church actually holds, uploaded through `/api/files`.
  fileId         String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  file StoredFile? @relation("GovernanceDocumentFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([kind])
  @@index([deletedAt])
}

///
/// A certificate the church has issued — baptism or dedication — in its own serial series.
/// The print is a browser act; the *record* is what makes a certificate official: a serial issued
/// once, the person and ceremony it certifies, who signed it, and whether a reissued copy supersedes
/// this one. The model deliberately holds what the printed page shows, so a reissue years later
/// reproduces the original wording rather than whatever the register says today.
model Certificate {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  /// The serial in the church's year series (`BAP-2026-0001`), issued by the server like a
  /// resolution code, so a certificate can be cited and found long after the service.
  serial       String
  kind         CertificateKind
  fullName     String
  /// The register number the certificate cites, as typed — a certificate may be issued for a
  /// ceremony recorded before this register, so it is text rather than a foreign key.
  memberNumber String?
  /// The member the certificate was issued from, when the person is on this roll. Null for a
  /// certificate issued for someone the register does not hold.
  memberId     String?
  member       Member?         @relation("CertificateMember", fields: [memberId], references: [id], onDelete: SetNull)
  parents      String?
  ceremonyDate DateTime?
  officiant    String?
  scripture    String?
  issuedById   String?
  issuedBy     User?           @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  /// A reissue names the copy it replaces, so the register shows one live certificate per ceremony.
  reissuesId   String?
  reissues     Certificate?    @relation("CertificateReissue", fields: [reissuesId], references: [id], onDelete: SetNull)
  reissuedBy   Certificate[]   @relation("CertificateReissue")
  issuedAt     DateTime        @default(now())
  createdAt    DateTime        @default(now())
  deletedAt    DateTime?

  @@unique([organizationId, serial])
  @@index([organizationId, kind])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------------------------
// Communications and community
// ---------------------------------------------------------------------------------------------

/// How loudly a notice asks to be read. The office's own judgement, recorded rather than styled:
/// an urgent notice is placed first and marked on every screen that shows the notice sheet.
enum AnnouncementPriority {
  normal
  urgent
}

model Announcement {
  id             String               @id @default(uuid())
  organizationId String               @default(dbgenerated())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  body           String
  audience       String               @default("Everyone")
  priority       AnnouncementPriority @default(normal)
  isPinned       Boolean              @default(false)
  publishedAt    DateTime             @default(now())
  expiresAt      DateTime?
  authorId       String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  author User? @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([organizationId])
  @@index([publishedAt])
  @@index([authorId])
  @@index([deletedAt])
}

/// A stored message. Sending is a separate concern, deliberately: a campaign that is composed and a
/// campaign that has been delivered are different states of the same row.
model Broadcast {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel        String
  subject        String?
  body           String
  audience       String
  status         String       @default("draft")
  scheduledFor   DateTime?
  sentAt         DateTime?
  recipients     Int          @default(0)
  /// What the email or SMS provider said about the last send: attempted, delivered, failed and the
  /// first few reasons. Null until it has been sent — a draft has no delivery to report.
  lastReport     Json?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  createdBy User? @relation("BroadcastAuthor", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
}

enum EventKind {
  service
  conference
  meeting
  outreach
}

model Event {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  kind           EventKind    @default(service)
  /// Who is running it. Null when nobody has been named yet, which is an honest state for a date
  /// that has been pencilled in.
  organizerId    String?
  organizer      Member?      @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  /// Whether the calendar still expects it. A postponed or called-off gathering is kept on the
  /// record rather than deleted, because the people who were told about it need to see why it moved.
  status         EventStatus  @default(scheduled)
  venue          String
  startsAt       DateTime
  endsAt         DateTime
  isRecurring    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([startsAt])
  @@index([deletedAt])
}

enum EventStatus {
  scheduled
  cancelled
}

enum PrayerStatus {
  open
  praying
  answered
  archived
}

model PrayerRequest {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberId       String?
  requesterName  String?
  request        String
  status         PrayerStatus @default(open)
  isPrivate      Boolean      @default(false)
  submittedAt    DateTime     @default(now())
  answeredAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  member Member? @relation(fields: [memberId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([memberId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------------------------
// Audit and recovery
// ---------------------------------------------------------------------------------------------

/// Append-only. No `updatedAt`, no `deletedAt`, and no update path in the code: the value of this
/// table is that its rows cannot change after they are written.
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId        String?
  action         AuditAction
  entityName     String
  entityId       String
  summary        String?
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([entityName, entityId])
  @@index([actorId])
  @@index([createdAt])
}

/// What the Trash screen reads. `snapshot` holds the deleted row so a restore does not depend on
/// the original still being reachable, and `restoreDeadline` is the 30-day window the console shows
/// a countdown for.
model SoftDeletedRecord {
  id              String       @id @default(uuid())
  organizationId  String       @default(dbgenerated())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entityName      String
  entityId        String
  entityLabel     String?
  reason          String
  reasonLabel     String
  snapshot        Json
  deletedAt       DateTime     @default(now())
  deletedById     String?
  restoreDeadline DateTime?
  restoredAt      DateTime?
  restoredById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  deletedBy  User? @relation("SoftDeleteActor", fields: [deletedById], references: [id])
  restoredBy User? @relation("SoftRestoreActor", fields: [restoredById], references: [id])

  @@index([organizationId])
  @@index([entityName, entityId])
  @@index([restoredAt])
}

// ---------------------------------------------------------------------------------------------
// Service & Worship
// ---------------------------------------------------------------------------------------------

enum LiturgyItemKind {
  call_to_worship
  praise_worship
  prayer
  scripture
  sermon
  offering
  announcements
  presentation
  dismissal
  other
}

/// One line in an order of service.
///
/// `position` is stored rather than implied by insertion order, because a liturgy is *rearranged*
/// constantly and "which item is third" must be answerable without trusting row ids or timestamps.
model OrderOfServiceItem {
  id              String          @id @default(uuid())
  organizationId  String          @default(dbgenerated())
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceId       String
  position        Int
  title           String
  kind            LiturgyItemKind @default(other)
  durationMinutes Int?
  responsible     String?
  ministryId      String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  ministry Ministry? @relation(fields: [ministryId], references: [id], onDelete: SetNull)

  @@unique([serviceId, position])
  @@index([organizationId])
  @@index([serviceId])
}

enum DutyStatus {
  scheduled
  confirmed
  completed
  missed
  replaced
  cancelled
}

/// One volunteer slot on one service. A person may hold several duties, which is why the unique key
/// is the role and not the person.
model RosterDuty {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceId      String
  memberId       String
  roleTitle      String
  ministryId     String?
  status         DutyStatus   @default(scheduled)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  holder       Member        @relation("DutyHolder", fields: [memberId], references: [id])
  ministry     Ministry?     @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  swapRequests SwapRequest[]

  @@unique([serviceId, memberId, roleTitle])
  @@index([organizationId])
  @@index([serviceId])
  @@index([memberId])
}

enum SwapStatus {
  requested
  approved
  declined
  cancelled
}

/// A handover of one duty. Kept as its own row rather than an edit to the duty, so the fact that a
/// volunteer asked, who agreed, and when, survives the handover itself.
model SwapRequest {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dutyId         String
  requestedById  String
  replacementId  String?
  status         SwapStatus   @default(requested)
  reason         String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  duty        RosterDuty @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  requestedBy Member     @relation("SwapRequester", fields: [requestedById], references: [id])
  replacement Member?    @relation("SwapReplacement", fields: [replacementId], references: [id])
  decidedBy   User?      @relation("SwapDecider", fields: [decidedById], references: [id])

  @@index([organizationId])
  @@index([dutyId])
  @@index([status])
}

/// The write-up of one service. `serviceId` is unique: a service has one report, revised, not a
/// growing pile of drafts that disagree.
model ServiceReport {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceId      String       @unique
  summary        String
  adultsCount    Int?
  childrenCount  Int?
  visitorsCount  Int?
  offeringsTotal Decimal?     @db.Decimal(12, 2)
  highlights     String?
  preparedById   String?
  /// When the report was signed off. A signed report can still be revised, but only by an
  /// administrator, and the revision is audited — see `upsertReport`.
  finalizedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  preparedBy User?   @relation("ServiceReportAuthor", fields: [preparedById], references: [id])

  @@index([organizationId])
}

// ---------------------------------------------------------------------------------------------
// Uploaded files
// ---------------------------------------------------------------------------------------------

/// What an uploaded file is for, which is what decides who may read it and how long it is kept.
///
/// Named by purpose rather than by mime type because the question the system actually asks is
/// "is this the church's logo?" and "is this a member's photograph?" — a PDF of a minute and a PDF
/// of a certificate have different audiences even though they are the same kind of file.
enum FilePurpose {
  logo
  member_photo
  document
  certificate_template
  other
}

/// A file the church has uploaded: the logo, a member's photograph, a scanned minute, a certificate
/// template.
///
/// The bytes are held in the database by default rather than in a directory on disk, because the
/// console is deployed to ephemeral containers (Railway, Render, Fly) where a local uploads folder is
/// wiped on every redeploy — a logo that disappears after a deploy is worse than no upload at all.
///
/// `storageKey` is the seam for object storage: when an S3-compatible bucket is configured, new
/// uploads record their object key there and leave `data` null, so one record shape serves both
/// drivers and a later migration to a bucket is a backfill rather than a rewrite.
model StoredFile {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purpose        FilePurpose  @default(other)
  fileName       String
  mimeType       String
  byteSize       Int
  /// Populated when the file is held in the database; null when it lives in object storage.
  data           Bytes?
  /// Populated when the file lives in object storage; null when it is held in the database.
  storageKey     String?
  uploadedById   String?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  uploadedBy User? @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  /// The places a file is currently referenced. Kept explicit rather than polymorphic so the
  /// foreign keys do their job and a deleted file cannot be left dangling on a profile.
  orgProfile     OrganizationProfile? @relation("OrgLogo")
  memberPhoto    Member?              @relation("MemberPhoto")
  governanceDocs GovernanceDocument[] @relation("GovernanceDocumentFile")

  @@index([organizationId])
  @@index([purpose])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------------------------
// The commercial layer — plans, subscriptions, and money received outside the product
// ---------------------------------------------------------------------------------------------

/// What a church buys, and what it may do.
///
/// A plan is a **platform** row, not a church's: the same three plans are offered to every parish, and
/// a per-church copy would drift the first time one was edited. What varies per church is the
/// `Subscription` pointing at one of these.
///
/// `limits` and `features` are JSON because they are short lists that will grow — members, accounts,
/// storage, SMS. Adding a key should not be a migration. The limits are read by the services that
/// enforce them, so a limit nobody reads is a limit nobody enforces.
model Plan {
  id        String          @id @default(uuid())
  /// The stable handle the console and the invoices use: `mustard-seed`. Never shown to a person.
  key       String          @unique
  name      String
  tagline   String?
  price     Decimal         @db.Decimal(12, 2)
  currency  String          @default("KES")
  interval  BillingInterval @default(monthly)
  /// Days of free use a church gets on this plan when it signs up. Zero means none.
  trialDays Int             @default(14)
  /// `{ "maxMembers": 300, "maxUsers": 8 }`. A missing key means *no* limit, deliberately: a limit
  /// nobody set must not read as zero and refuse the church its first member.
  limits    Json
  /// The bullet points the plans screen lists.
  features  Json
  /// Whether the plan is offered on the church's own upgrade screen. `false` means Praxis offers it
  /// in a conversation, which is how the largest parishes are handled.
  isPublic  Boolean         @default(true)
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[] @relation("SubscribedPlan")
  requests      Subscription[] @relation("RequestedPlan")
}

enum BillingInterval {
  monthly
  yearly
}

enum SubscriptionStatus {
  /// Inside the free period. The church has full use of what it signed up for.
  trial
  /// Paid up and inside the current period.
  active
  /// The period ended and no payment has been recorded. Still usable, and not quietly: everything
  /// tells the office the bill is due before anything stops.
  past_due
  /// The church said it is leaving. It keeps its data and its access until the period ends.
  cancelled
  /// Lapsed. Writes stop and the console shows the way back; the records stay exactly where they are.
  expired
}

/// One church's commercial standing. Exactly one per church, which is what `@unique` says.
///
/// Status is *stored* as well as computed: the nightly-or-on-read walk in `subscription.service.ts`
/// moves a lapsed trial or period forward, and a status nobody can query is a status the console
/// would have to re-derive differently from the server.
model Subscription {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation("SubscribedPlan", fields: [planId], references: [id])

  status SubscriptionStatus @default(trial)

  /// When the free period ends. Left in place after it does, so the upgrade screen can say when the
  /// trial ran out rather than only that it did.
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?

  /// An upgrade the church has asked for and Praxis has not confirmed yet. Manual billing needs the
  /// request to be a record rather than an email, or the office is the only one holding it.
  requestedPlanId String?
  requestedPlan   Plan?     @relation("RequestedPlan", fields: [requestedPlanId], references: [id])
  requestedAt     DateTime?

  /// For the human on the next step: "paid by M-Pesa 15 Sep, awaiting the receipt".
  notes String?

  payments  SubscriptionPayment[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
}

/// One payment received outside the product: M-Pesa, a bank transfer, a cheque, cash at the office.
///
/// Recording it by hand is the honest foundation rather than a shortcut. It is what a Kenyan parish
/// office does anyway, it means a church is never blocked waiting for a card processor, and it puts
/// the money fact in the database where the subscription period can be derived from it.
///
/// Like every other money record here, a payment is never edited: a mistake is corrected by recording
/// the reversal and a fresh payment, with the note saying why.
model SubscriptionPayment {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("KES")
  method      PaymentMethod @default(mpesa)
  /// The M-Pesa code, the bank slip number, the cheque number — whatever the office can look up.
  reference   String?
  /// The months this money bought. Set when the payment is recorded, so the period is auditable
  /// rather than recomputed from a total that later payments would shift.
  periodStart DateTime?
  periodEnd   DateTime?

  receivedAt DateTime @default(now())
  note       String?

  recordedById String?
  recordedBy   User?    @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------------------------
// Inventory and assets
// ---------------------------------------------------------------------------------------------

/// What a movement did to the quantity. The set is the set of ways a shelf figure can honestly
/// change: bought, given out, brought back, moved, corrected, or lost. A transfer changes where a
/// thing is, not how much of it exists, so it carries no quantity delta.
enum StockMovementKind {
  purchase
  issue
  return
  transfer
  adjustment
  loss
  damage
}

/// Consumable stock the church uses up (bookshop lines, kitchen supplies) and durable assets it
/// keeps (sound gear, instruments). One table rather than two, because both are named, located,
/// counted and issued — the difference is whether "quantity" means units on a shelf or 1.
enum InventoryKind {
  consumable
  asset
}

/// A durable asset's working life. A consumable's condition is not tracked: it is used up, and its
/// `status` is active until retired.
enum AssetCondition {
  good
  fair
  poor
}

/// Why a thing is (or is not) in service. `disposed` is what retiring an asset records; `lost` and
/// `damaged` are the states a loss or damage movement puts an asset in.
enum InventoryStatus {
  active
  in_service
  maintenance
  lost
  damaged
  disposed
}

/// A stock take's life. `counting` while the count is gathered, `review` once the variance is
/// visible, and only `approved` touches the shelf — approval is what makes the adjustment real.
enum StockTakeStatus {
  counting
  review
  approved
  cancelled
}

/// Who stock was bought from. Deliberately its own model rather than a string: the purchases screen
/// groups by supplier, and a misspelled vendor string would split one supplier into three.
model Supplier {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  name      String
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items     InventoryItem[]
  purchases Purchase[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// One line of the register: what the church owns, where it is, how much there is.
///
/// `quantity` is the *derived* figure — the sum of its movements — and is stored so lists and reports
/// do not have to aggregate a ledger to render a shelf. The movements are the truth; a write to
/// `quantity` that did not go through a movement is a discrepancy, which is why every service path
/// adjusts the two together inside one transaction.
model InventoryItem {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  sku           String
  name          String
  kind          InventoryKind   @default(consumable)
  category      String
  unit          String          @default("pcs")
  location      String
  quantity      Int             @default(0)
  reorderAt     Int?
  cost          Decimal?        @db.Decimal(12, 2)
  status        InventoryStatus @default(active)
  condition     AssetCondition?
  supplierId    String?
  purchasedAt   DateTime?
  custodianId   String?
  notes         String?
  lastCountedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  custodian     Member?         @relation("InventoryCustodian", fields: [custodianId], references: [id])
  movements     StockMovement[]
  issues        Issue[]
  transfers     Transfer[]
  stockTakes    StockTake[]
  purchaseLines PurchaseLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, status])
}

/// The ledger of how a quantity changed. Append-only in practice — nothing edits a movement, a
/// correction is another movement — and never soft-deleted: the history is the point of it.
model StockMovement {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  kind         StockMovementKind
  /// Signed: positive adds to the shelf, negative takes away. A transfer's line is 0 — the item
  /// moved, nothing was created or destroyed.
  delta        Int
  /// What the shelf read after this movement landed. Recording it means any later dispute can be
  /// answered without replaying the ledger.
  balanceAfter Int
  reference    String?
  note         String?
  actorId      String?
  actor        User?             @relation("StockActor", fields: [actorId], references: [id], onDelete: SetNull)
  occurredAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())

  @@index([organizationId])
  @@index([itemId, occurredAt])
}

/// One act of counting the shelf. The variance is computed and shown, and an administrator approves
/// the adjustment — the only path by which a count changes stock.
model StockTake {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  status          StockTakeStatus @default(counting)
  bookQuantity    Int
  countedQuantity Int?
  variance        Int?
  countedById     String?
  countedBy       User?           @relation("StockTaker", fields: [countedById], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      User?           @relation("StockTakeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId])
  @@index([itemId])
}

/// A buy. Header-plus-lines so one receipt of many things is one purchase, and `total` is computed
/// from the lines inside the transaction rather than trusted from the client.
model Purchase {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  reference    String?
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  total        Decimal   @default(0) @db.Decimal(12, 2)
  purchasedAt  DateTime  @default(now())
  note         String?
  recordedById String?
  recordedBy   User?     @relation("PurchaseRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines PurchaseLine[]

  @@index([organizationId])
  @@index([purchasedAt])
}

/// One item bought in one purchase. Its own table because the movement engine needs per-item
/// quantities and costs, and a header row cannot carry them.
model PurchaseLine {
  id         String        @id @default(uuid())
  purchaseId String
  purchase   Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity Int
  unitCost Decimal? @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([itemId])
}

/// Stock or an asset handed to a person for a ministry's use. The authorizer is the person whose
/// name the register records as having let it leave the cupboard.
model Issue {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity       Int
  issuedToName   String
  ministryId     String?
  ministry       Ministry? @relation(fields: [ministryId], references: [id])
  reason         String?
  issuedAt       DateTime  @default(now())
  issuedById     String?
  issuedBy       User?     @relation("IssueIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  authorizedById String?
  authorizedBy   User?     @relation("IssueAuthorizer", fields: [authorizedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([itemId])
}

/// A move between two named places — rooms, departments, churches on the same register. History is
/// the movements it wrote, so a transfer is never deleted either.
model Transfer {
  id             String       @id @default(uuid())
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity        Int
  fromLocation    String
  toLocation      String
  note            String?
  transferredAt   DateTime @default(now())
  transferredById String?
  transferredBy   User?    @relation("TransferMover", fields: [transferredById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([itemId])
}
