# ---------------------------------------------------------------------------------------------
# Praxis API — environment
#
# Copy to `.env` for local work. In the cloud these are service variables instead (Railway, Fly,
# Render). The service validates them at startup and refuses to boot if one is missing or if a
# production secret is still the placeholder (see src/config/env.ts).
# ---------------------------------------------------------------------------------------------

# --- Database (Neon, or any Postgres) ---------------------------------------------------------
#
# This service owns one Postgres. Two URLs, because Neon (and any PgBouncer front end) serves the
# application and migrations on different connections:
#
#   DATABASE_URL  the *pooled* connection the app uses at runtime   (host contains "-pooler")
#   DIRECT_URL    the *unpooled* connection `prisma migrate` uses    (host without "-pooler")
#
# Locally both are the same line. On Neon, copy the "Pooled connection" string into DATABASE_URL and
# the "Direct connection" string into DIRECT_URL, and append `?sslmode=require` to each.
DATABASE_URL="postgresql://praxis:praxis@localhost:5432/praxis?schema=public"
DIRECT_URL="postgresql://praxis:praxis@localhost:5432/praxis?schema=public"

# --- Auth ------------------------------------------------------------------------------------
#
# Signs the access token. Must be a long random string in any real deployment — the app refuses to
# start with the placeholder outside development (see src/config/env.ts). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ----------------------------------------------------------------------------------
# PORT is supplied by the host in the cloud; set it here only for local runs.
PORT=4000
NODE_ENV=development

# The console's origin(s). A comma-separated list, so the parish LAN address and the hosted console
# can both be allowed during a move. In the cloud this is the Pages/Netlify URL, for example:
#   CORS_ORIGIN="https://praxis-console.pages.dev"
#
# For local work list **both** loopback spellings. A browser treats `localhost` and `127.0.0.1` as
# different origins, and the difference is invisible until a sign-in is refused: Vite answers on both,
# so whichever one is typed into the address bar becomes the `Origin` this API has to accept. The
# browser audits default to 127.0.0.1, so omitting it here is what makes `npm run audit:a11y` fail
# with "could not sign in" against an API that is running perfectly well.
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Hashing cost. 12 matches the reference parish system; do not lower it.
BCRYPT_ROUNDS=12

# --- Uploads ---------------------------------------------------------------------------------
#
# Files are held in the database by default. That is the right default here: the API runs on
# ephemeral containers where a local uploads directory is wiped on every redeploy, and the database
# is the thing that already has a backup story.
#
# STORAGE_DRIVER=s3 is the documented seam to move the bytes to a bucket later. It reserves these
# variables but is not implemented in this build — selecting it fails loudly at startup rather than
# quietly writing somewhere else.
UPLOAD_MAX_BYTES=5242880
STORAGE_DRIVER="database"
# S3_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
# S3_REGION="auto"
# S3_BUCKET="praxis-uploads"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Outbound email ------------------------------------------------------------------------
#
# `console` sends nothing, and the API *says so* rather than marking a campaign sent over a provider
# that was never configured — pressing send returns a precise 503 telling you what to set. That is
# the safe default for a fresh install.
#
# To send for real: create a Resend account, verify the sending domain, then set the two below.
# EMAIL_FROM must be on a domain you have verified with the provider.
EMAIL_DRIVER="console"
# RESEND_API_KEY="re_..."
EMAIL_FROM="Praxis Church Console <onboarding@resend.dev>"
APP_NAME="Praxis Church Console"
PUBLIC_APP_URL="http://localhost:3000"

# --- Outbound SMS ----------------------------------------------------------------------------
#
# Same shape. Africa's Talking is the natural first choice for a Kenyan parish; Twilio is the branch
# for anywhere else. Both are wired and either is one variable away.
SMS_DRIVER="console"
# AFRICASTALKING_USERNAME="praxis"
# AFRICASTALKING_API_KEY=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+1..."
