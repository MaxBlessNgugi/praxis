# The database this service owns. The parish deployment runs one Postgres; point this at it.
DATABASE_URL="postgresql://praxis:praxis@localhost:5432/praxis?schema=public"

# Signs the access token. Must be a long random string in any real deployment — the app refuses
# to start with the placeholder outside development (see src/config/env.ts).
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# The console's origin. A comma-separated list is allowed, so the LAN address of the parish
# machine can sit beside localhost during setup.
CORS_ORIGIN="http://localhost:3000"

# Hashing cost. 12 matches the reference parish system; do not lower it.
BCRYPT_ROUNDS=12
